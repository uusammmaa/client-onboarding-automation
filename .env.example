# ---------------------------------------------------------------------------
# All optional. With no Google credentials the app runs entirely in memory and
# says so in the header, which is how the hosted demo works.
# ---------------------------------------------------------------------------

# --- Google (Sheets + Drive + Gmail) ---------------------------------------
# One service account covers all three. Gmail needs the impersonation subject,
# because a service account has no mailbox of its own to send from.
# Paste the key with literal \n escapes; hosting UIs flatten real newlines.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATE_SUBJECT=studio@your-company.co.uk
GMAIL_SEND_AS=studio@your-company.co.uk

# --- Where things go -------------------------------------------------------
# The long string in the spreadsheet URL between /d/ and /edit.
SHEETS_SPREADSHEET_ID=
SHEETS_CLIENTS_TAB=Clients
SHEETS_ERRORS_TAB=Errors
# The long string at the end of the Drive folder URL.
DRIVE_CLIENTS_FOLDER_ID=

# --- Who hears about it ----------------------------------------------------
ALERT_TO=studio@your-company.co.uk
ALERT_CC=accounts@your-company.co.uk

# --- Local flavour ---------------------------------------------------------
COMPANY_NAME=AMRL Media
CLIENT_ID_PREFIX=AMRL
# Briefs are assigned round-robin by project type.
TEAM_ROSTER=Nadia,Joel,Priya
